# ==== Telegram ====
BOT_TOKEN=your_bot_token_here

# Личный чат, где ты пишешь боту (узнать: /get_chat_info в личке с ботом)
MAIN_CHAT_ID=

# Чат-форум для отчётов (узнать: /get_chat_info в этом чате)
REPORT_CHAT_ID=

# Кому разрешено пользоваться ботом (id через запятую; узнать: /get_chat_info)
ADMIN_IDS=

# ==== Топики отчётного чата (thread_id) ====
# Открой нужный топик и отправь в нём /get_chat_info — бот покажет ID
TOPIC_DIARY_ID=
TOPIC_SLEEP_ID=
TOPIC_WEIGHT_ID=
TOPIC_TRAINING_ID=
TOPIC_CLIMBING_ID=
TOPIC_HANGS_ID=
TOPIC_STEPS_ID=
TOPIC_NUTRITION_ID=
TOPIC_ROUTINES_ID=
TOPIC_LFK_ID=
TOPIC_ANALYTICS_ID=

# ==== База данных ====
# По умолчанию SQLite в ./data (сохраняется между перезапусками)
DATABASE_URL=sqlite+aiosqlite:///./data/diary.db
# PostgreSQL (опционально):
# DATABASE_URL=postgresql+asyncpg://diary:password@db:5432/diary

# ==== Прочее ====
LOG_LEVEL=INFO
TZ=Europe/Moscow

# Норма белка в сутки, г (для графика белка: зелёный — норма набрана, жёлтый — нет)
PROTEIN_NORM_PER_DAY=120

# Автоотчёт за прошедший день в отчётный чат
AUTO_REPORT=true
REPORT_HOUR=9
REPORT_MINUTE=0
# Пауза между сообщениями в отчётный чат, сек (защита от лимитов Telegram ~20 сообщений/мин)
REPORT_SEND_INTERVAL=3.0

# ==== Опросы в личном чате (бот пишет сам) ====
# Требуется MAIN_CHAT_ID. Время — в часовом поясе TZ.
SURVEYS_ENABLED=true
MORNING_WEEKDAY_HOUR=8
MORNING_WEEKDAY_MINUTE=0
MORNING_WEEKEND_HOUR=9
MORNING_WEEKEND_MINUTE=0
EVENING_HOUR=23
EVENING_MINUTE=30
