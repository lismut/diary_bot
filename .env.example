# Telegram Bot
BOT_TOKEN=your_bot_token_here

# Main chat ID (where user inputs data) - can be configured via /get_chat_info
MAIN_CHAT_ID=

# Report/forum chat ID (where reports are posted) - can be configured via /get_chat_info
REPORT_CHAT_ID=

# Topics in report chat (thread IDs) - can be configured via /get_chat_info
TOPIC_SLEEP_ID=
TOPIC_WEIGHT_ID=
TOPIC_TRAINING_ID=
TOPIC_CLIMBING_ID=
TOPIC_HANGS_ID=
TOPIC_STEPS_ID=
TOPIC_NUTRITION_ID=
TOPIC_ROUTINES_ID=
TOPIC_ANALYTICS_ID=

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/diary.db
# Or for PostgreSQL: postgresql+asyncpg://user:pass@host:port/db

# Logging
LOG_LEVEL=INFO

# Nutrition config
PROTEIN_NORM_PER_DAY=120  # grams
# Protein per 100g for specific foods - will be in config/foods.json
